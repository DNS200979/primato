# Supabase DEDICADO da Primato (projeto próprio — nunca o da CONFAF nem o do ERP)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=<anon key>
SUPABASE_SERVICE_KEY=<service role key — só no servidor, nunca no frontend>

# Storage
SUPABASE_BUCKET_DOCUMENTOS=documentos-primato

# Leitura documental por IA (opcional). Sem a chave, cai na heurística
# embarcada e o restante vai para conferência humana.
ANTHROPIC_API_KEY=
CLAUDE_MODELO_LEITURA=claude-opus-5
IA_LEITURA_HABILITADA=1

# Safra corrente exibida por padrão
SAFRA_CORRENTE=2026/2027

# URL pública (links e CORS)
APP_BASE_URL=
